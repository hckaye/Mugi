<Project>
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Mugi.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Mugi.Generators.dll" />
    <CompilerVisibleProperty Include="MugiJsonNaming" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MugiOpenApi" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MugiOpenApiNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MugiOpenApiClient" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MugiOpenApiClientName" />
  </ItemGroup>
</Project>

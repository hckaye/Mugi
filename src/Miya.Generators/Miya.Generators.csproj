<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Miya.Generators</PackageId>
    <Description>Compile-time JSON codecs, route templates, and typed input binders for Miya.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <Compile Include="../Miya.Generators.Core/**/*.cs"
             Exclude="../Miya.Generators.Core/bin/**/*.cs;../Miya.Generators.Core/obj/**/*.cs"
             LinkBase="Miya.Generators.Core" />
    <AdditionalFiles Include="../Miya.Generators.Core/AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="../Miya.Generators.Core/AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="buildTransitive/Miya.Generators.props" Pack="true" PackagePath="buildTransitive/Miya.Generators.props" />
  </ItemGroup>

</Project>

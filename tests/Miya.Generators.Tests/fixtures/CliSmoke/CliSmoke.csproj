<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Pinned so the asserted OpenAPI info.version does not change with the repository version. -->
    <Version>1.2.3</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(GeneratedOutput)' != ''">
    <Compile Include="$(GeneratedOutput)/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Miya/Miya.csproj" />
  </ItemGroup>
</Project>
